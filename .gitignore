# —— 依赖与缓存 ——
node_modules/

# —— 构建产物 ——
# dist 下只备份两个最终交付物（exe 单文件、debug APK）；
# onedir 文件夹与 build/、web/ 都可由源重建，不入库。
dist/*
!dist/Jianting.exe
!dist/Jianting-debug.apk
build/
web/

# —— Python ——
__pycache__/
*.pyc

# —— Android（Capacitor 工程生成物与机器本地配置）——
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/

# —— 系统/编辑器杂项 ——
Thumbs.db
Desktop.ini

# Kotlin 构建缓存
android/.kotlin/
